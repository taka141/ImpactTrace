@model ImpactTrace.Web.Models.VerificationViewModel
@{
    ViewData["Title"] = "Recording Verification";
}

<div class="container mt-4">
    <h1 class="mb-4">Recording Verification & Details</h1>

    <div class="card mb-4">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0">Filter Options</h5>
        </div>
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3">
                <div class="col-md-3">
                    <label for="filterOperationName" class="form-label">Operation Type</label>
                    <input type="text" class="form-control" id="filterOperationName" name="filterOperationName" 
                           value="@Model.FilterOperationName" placeholder="INSERT, UPDATE, DELETE">
                </div>
                <div class="col-md-3">
                    <label for="filterTableName" class="form-label">Table Name</label>
                    <input type="text" class="form-control" id="filterTableName" name="filterTableName" 
                           value="@Model.FilterTableName" placeholder="Table name">
                </div>
                <div class="col-md-2">
                    <label for="filterStartTime" class="form-label">Start Time</label>
                    <input type="datetime-local" class="form-control" id="filterStartTime" name="filterStartTime" 
                           value="@Model.FilterStartTime?.ToString("yyyy-MM-ddTHH:mm")">
                </div>
                <div class="col-md-2">
                    <label for="filterEndTime" class="form-label">End Time</label>
                    <input type="datetime-local" class="form-control" id="filterEndTime" name="filterEndTime" 
                           value="@Model.FilterEndTime?.ToString("yyyy-MM-ddTHH:mm")">
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">Apply Filter</button>
                </div>
            </form>
            @if (!string.IsNullOrEmpty(Model.FilterOperationName) || !string.IsNullOrEmpty(Model.FilterTableName) 
                || Model.FilterStartTime.HasValue || Model.FilterEndTime.HasValue)
            {
                <div class="mt-3">
                    <a asp-action="Index" class="btn btn-secondary btn-sm">Clear Filters</a>
                </div>
            }
        </div>
    </div>

    @if (!Model.Recordings.Any())
    {
        <div class="alert alert-warning">
            <strong>No recordings found</strong> matching the filter criteria.
        </div>
    }
    else
    {
        @foreach (var recording in Model.Recordings)
        {
            <div class="card mb-4">
                <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-0">@recording.Name</h5>
                        <small>
                            Started: @recording.StartTime.ToString("yyyy-MM-dd HH:mm:ss") | 
                            @if (recording.EndTime.HasValue)
                            {
                                @:Ended: @recording.EndTime.Value.ToString("yyyy-MM-dd HH:mm:ss")
                            }
                            else
                            {
                                <span class="badge bg-warning">Still Recording</span>
                            }
                        </small>
                    </div>
                    <div>
                        <span class="badge bg-light text-dark me-2">@recording.OperationCount Operations</span>
                        <a asp-action="ExportToExcel" asp-route-recordingId="@recording.Id" class="btn btn-success btn-sm">
                            <i class="bi bi-file-earmark-excel"></i> Excel
                        </a>
                        <a asp-action="ExportToCsv" asp-route-recordingId="@recording.Id" class="btn btn-info btn-sm">
                            <i class="bi bi-file-earmark-text"></i> CSV
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    @if (!recording.Operations.Any())
                    {
                        <p class="text-muted">No operations captured in this recording.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th style="width: 5%">ID</th>
                                        <th style="width: 15%">Table Name</th>
                                        <th style="width: 10%">Operation</th>
                                        <th style="width: 50%">SQL Sample</th>
                                        <th style="width: 20%">Executed At</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var op in recording.Operations)
                                    {
                                        <tr>
                                            <td>@op.Id</td>
                                            <td>
                                                <span class="badge bg-primary">@op.TableName</span>
                                            </td>
                                            <td>
                                                @if (op.OperationType == "INSERT")
                                                {
                                                    <span class="badge bg-success">INSERT</span>
                                                }
                                                else if (op.OperationType == "UPDATE")
                                                {
                                                    <span class="badge bg-warning text-dark">UPDATE</span>
                                                }
                                                else if (op.OperationType == "DELETE")
                                                {
                                                    <span class="badge bg-danger">DELETE</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@op.OperationType</span>
                                                }
                                            </td>
                                            <td>
                                                <code style="font-size: 0.85em;">
                                                    @if (op.SqlText.Length > 100)
                                                    {
                                                        @(op.SqlText.Substring(0, 100) + "...")
                                                    }
                                                    else
                                                    {
                                                        @op.SqlText
                                                    }
                                                </code>
                                            </td>
                                            <td>@op.ExecutedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
    }

    <div class="mt-3">
        <a asp-controller="Recording" asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Recording Control
        </a>
    </div>
</div>

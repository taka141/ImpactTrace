@model ImpactTrace.Web.Models.Recording
@{
    ViewData["Title"] = $"Recording Details - {Model.Name}";
}

<div class="container mt-4">
    <h1 class="mb-4">Recording Details</h1>

    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">@Model.Name</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <strong>Recording ID:</strong>
                    <p>@Model.Id</p>
                </div>
                <div class="col-md-3">
                    <strong>Start Time:</strong>
                    <p>@Model.StartTime.ToString("yyyy-MM-dd HH:mm:ss")</p>
                </div>
                <div class="col-md-3">
                    <strong>End Time:</strong>
                    <p>
                        @if (Model.EndTime.HasValue)
                        {
                            @Model.EndTime.Value.ToString("yyyy-MM-dd HH:mm:ss")
                        }
                        else
                        {
                            <span class="badge bg-warning">Still Recording</span>
                        }
                    </p>
                </div>
                <div class="col-md-3">
                    <strong>Status:</strong>
                    <p>
                        @if (Model.IsRecording)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Completed</span>
                        }
                    </p>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-md-12">
                    <strong>Total Operations:</strong>
                    <p>@Model.Operations.Count operations captured</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">SQL Operations</h5>
            <div>
                <a asp-action="ExportToExcel" asp-route-recordingId="@Model.Id" class="btn btn-success btn-sm">
                    <i class="bi bi-file-earmark-excel"></i> Export to Excel
                </a>
                <a asp-action="ExportToCsv" asp-route-recordingId="@Model.Id" class="btn btn-info btn-sm">
                    <i class="bi bi-file-earmark-text"></i> Export to CSV
                </a>
            </div>
        </div>
        <div class="card-body">
            @if (!Model.Operations.Any())
            {
                <p class="text-muted">No operations captured in this recording.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th style="width: 5%">ID</th>
                                <th style="width: 15%">Table Name</th>
                                <th style="width: 10%">Operation</th>
                                <th style="width: 50%">SQL Text</th>
                                <th style="width: 20%">Executed At</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var op in Model.Operations)
                            {
                                <tr>
                                    <td>@op.Id</td>
                                    <td>
                                        <span class="badge bg-primary">@op.TableName</span>
                                    </td>
                                    <td>
                                        @if (op.OperationType == "INSERT")
                                        {
                                            <span class="badge bg-success">INSERT</span>
                                        }
                                        else if (op.OperationType == "UPDATE")
                                        {
                                            <span class="badge bg-warning text-dark">UPDATE</span>
                                        }
                                        else if (op.OperationType == "DELETE")
                                        {
                                            <span class="badge bg-danger">DELETE</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@op.OperationType</span>
                                        }
                                    </td>
                                    <td>
                                        <details>
                                            <summary style="cursor: pointer;">
                                                <code style="font-size: 0.85em;">
                                                    @if (op.SqlText.Length > 80)
                                                    {
                                                        @(op.SqlText.Substring(0, 80) + "...")
                                                    }
                                                    else
                                                    {
                                                        @op.SqlText
                                                    }
                                                </code>
                                            </summary>
                                            <pre class="mt-2 p-2 bg-light" style="font-size: 0.85em; white-space: pre-wrap;">@op.SqlText</pre>
                                        </details>
                                    </td>
                                    <td>@op.ExecutedAt.ToString("yyyy-MM-dd HH:mm:ss.fff")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-3">
                    <h6>Summary by Operation Type:</h6>
                    <ul>
                        @foreach (var group in Model.Operations.GroupBy(o => o.OperationType))
                        {
                            <li><strong>@group.Key:</strong> @group.Count() operations</li>
                        }
                    </ul>

                    <h6>Summary by Table:</h6>
                    <ul>
                        @foreach (var group in Model.Operations.GroupBy(o => o.TableName))
                        {
                            <li><strong>@group.Key:</strong> @group.Count() operations</li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Verification
        </a>
        <a asp-controller="Recording" asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-house"></i> Back to Recording Control
        </a>
    </div>
</div>
